<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>{{ server.name }} — {{ server.sport }}</title>
<style>
  body {
    margin: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: Arial, Helvetica, sans-serif;
    background: {{ server.color }};
    color: #fff;
    text-align: center;
  }
  .emoji { font-size: 6rem; margin-bottom: 0.5rem; }
  h1 { font-size: 2.5rem; margin: 0.2rem; }
  h2 { font-weight: normal; opacity: 0.85; }
  .badge {
    margin-top: 2rem;
    padding: 0.5rem 1.2rem;
    border: 2px solid #fff;
    border-radius: 999px;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }
</style>
</head>
<body>
  <div class="emoji">{{ server.emoji }}</div>
  <h1>{{ server.sport }}</h1>
  <h2>Servi par le conteneur : <strong>{{ server.name }}</strong></h2>
  <div class="badge">Backend Nginx — HTTP :80 — derrière HAProxy</div>
</body>
</html>
